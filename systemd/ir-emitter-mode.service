[Unit]
Description=Enable the IR emitter on the integrated camera (ThinkPad L14 Gen 1)
Documentation=https://github.com/Page0031/thinkpad-l14-gen1-ir-face-login
# 设备出现后再跑；并在 irisd 之前，保证 GDM 第一次扫脸时灯已经亮着
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service
Before=irisd.service
# 唤醒后也要重设（摄像头掉电会丢失该状态）
After=suspend.target sleep.target hybrid-sleep.target hibernate.target suspend-then-hibernate.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/ir-emitter-mode.py
# 非关键路径：摄像头缺失或写入失败也不能挡住启动
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target suspend.target sleep.target hybrid-sleep.target hibernate.target suspend-then-hibernate.target
